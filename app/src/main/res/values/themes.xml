<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the entire UI, so the platform theme only needs to provide a
      dark, action-bar-less window and a matching starting window. The window
      background follows the system's light/dark so the starting window is not
      a black flash under a forced light theme (see values-night for the dark half).
    -->
    <style name="Theme.WearXMusic" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
